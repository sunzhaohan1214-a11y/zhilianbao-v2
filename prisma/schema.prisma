generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum PersonStatus {
  ACTIVE
  ARCHIVED
}

enum AccountStatus {
  PENDING_ENABLE
  UNACTIVATED
  NORMAL
  DISABLED
}

enum OrganizationType {
  TOWNSHIP_ORG
  DEPARTMENT
  DISPATCH_UNIT
  POST_UNIT
  OTHER_INTERNAL
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum AdministrativeAreaType {
  COUNTY
  TOWNSHIP
  PARK
  HIGH_TECH_ZONE
  DEVELOPMENT_ZONE
  OTHER_AREA
}

enum RoleCode {
  MEMBER_CURRENT
  MEMBER_ALUMNI_PLATFORM
  GROUP_LEADER
  MINISTER
  TOWNSHIP_STAFF
  DEPARTMENT_STAFF
  ADMIN
  SUPER_ADMIN
  LEADER_STAGE2
}

enum BatchStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum MemberDemandType {
  TECHNICAL
  TALENT
  PROJECT
  OTHER
}

enum JobStatus {
  WAITING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum AuthRateLimitDimension {
  PHONE
  IP
  DEVICE
}

enum AttachmentStorageProvider {
  TENCENT_COS
}

enum AttachmentUploadStatus {
  PENDING_UPLOAD
  UPLOADED
  ABORTED
  FAILED
}

enum AttachmentScanStatus {
  PENDING
  SCANNING
  PASSED
  REJECTED
  FAILED
}

enum AttachmentPermissionLevel {
  PARENT_AUTHORIZED
  SENSITIVE_PARENT
}

enum AttachmentAccessAction {
  PREVIEW
  DOWNLOAD
}

enum EnterpriseStatus {
  NORMAL
  DISABLED
  MERGED
}

enum EnterpriseGeocodeStatus {
  UNRESOLVED
  RESOLVED
  MANUAL
  FAILED
}

enum EnterpriseContactStatus {
  ACTIVE
  INACTIVE
}

enum EnterpriseChangeRequestType {
  CREATE
  CORRECTION
}

enum EnterpriseChangeRequestStatus {
  PENDING_REVIEW
  APPROVED
  RETURNED
  CLOSED
}

enum EnterpriseVersionChangeType {
  CREATE
  FORMAL_CORRECTION
  CHANGE_REQUEST_APPROVED
  DISABLE
  RESTORE
  MERGE
  COORDINATE
}

model Person {
  id                            String                    @id @default(uuid()) @db.Char(36)
  name                          String                    @db.VarChar(80)
  contactPhone                  String?                   @map("contact_phone") @db.VarChar(30)
  personStatus                  PersonStatus              @default(ACTIVE) @map("person_status")
  createdAt                     DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                     DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)
  account                       Account?
  phoneChanges                  AccountPhoneHistory[]     @relation("PhoneChangeAccount")
  appointments                  Appointment[]
  roleAssignments               RoleAssignment[]          @relation("RoleAssignmentPerson")
  grantedRoleAssignments        RoleAssignment[]          @relation("RoleAssignmentGrantor")
  specialPermissionGrants       SpecialPermissionGrant[]  @relation("PermissionGrantPerson")
  grantedSpecialPermissions     SpecialPermissionGrant[]  @relation("PermissionGrantGrantor")
  batchMemberships              BatchMembership[]
  groupLeaderAssignments        GroupLeaderAssignment[]   @relation("GroupLeaderPerson")
  grantedGroupLeaderAssignments GroupLeaderAssignment[]   @relation("GroupLeaderGrantor")
  memberCapabilityProfile       MemberCapabilityProfile?  @relation("MemberCapabilityPerson")
  updatedMemberCapabilities     MemberCapabilityProfile[] @relation("MemberCapabilityUpdater")
  auditLogs                     AuditLog[]
  stateTransitions              StateTransitionHistory[]
  uploadedAttachments           Attachment[]              @relation("AttachmentUploader")
  createdAttachmentLinks        AttachmentLink[]          @relation("AttachmentLinkCreator")
  attachmentAccessLogs          AttachmentAccessLog[]     @relation("AttachmentAccessPerson")
  createdEnterprises            Enterprise[]              @relation("EnterpriseCreator")
  coordinatedEnterprises        Enterprise[]              @relation("EnterpriseCoordinateUpdater")
  createdEnterpriseContacts     EnterpriseContact[]
  submittedEnterpriseRequests   EnterpriseChangeRequest[] @relation("EnterpriseRequestSubmitter")
  reviewedEnterpriseRequests    EnterpriseChangeRequest[] @relation("EnterpriseRequestReviewer")
  enterpriseVersions            EnterpriseVersion[]
  presenceReports              PresenceReport[]
  createdMapBoundaryVersions   MapBoundaryVersion[]      @relation("MapBoundaryCreator")

  @@index([personStatus])
  @@map("persons")
}

model Account {
  id                         String                @id @default(uuid()) @db.Char(36)
  personId                   String                @unique @map("person_id") @db.Char(36)
  phone                      String                @unique @db.VarChar(20)
  passwordHash               String                @map("password_hash") @db.VarChar(255)
  status                     AccountStatus         @default(PENDING_ENABLE)
  forcePasswordChange        Boolean               @default(false) @map("force_password_change")
  firstPasswordChangedAt     DateTime?             @map("first_password_changed_at") @db.DateTime(3)
  confidentialityConfirmedAt DateTime?             @map("confidentiality_confirmed_at") @db.DateTime(3)
  permissionVersion          BigInt                @default(1) @map("permission_version") @db.UnsignedBigInt
  lastLoginAt                DateTime?             @map("last_login_at") @db.DateTime(3)
  createdAt                  DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                  DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  person                     Person                @relation(fields: [personId], references: [id], onDelete: Restrict)
  phoneHistory               AccountPhoneHistory[]
  sessions                   Session[]
  auditLogs                  AuditLog[]

  @@index([status])
  @@map("accounts")
}

model AccountPhoneHistory {
  id                String   @id @default(uuid()) @db.Char(36)
  accountId         String   @map("account_id") @db.Char(36)
  oldPhone          String   @map("old_phone") @db.VarChar(20)
  newPhone          String   @map("new_phone") @db.VarChar(20)
  reason            String   @db.VarChar(500)
  changedByPersonId String   @map("changed_by_person_id") @db.Char(36)
  changedAt         DateTime @default(now()) @map("changed_at") @db.DateTime(3)
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  changedByPerson   Person   @relation("PhoneChangeAccount", fields: [changedByPersonId], references: [id], onDelete: Restrict)

  @@index([accountId, changedAt])
  @@index([changedByPersonId, changedAt])
  @@map("account_phone_history")
}

model Session {
  id                String    @id @default(uuid()) @db.Char(36)
  accountId         String    @map("account_id") @db.Char(36)
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  deviceId          String    @map("device_id") @db.VarChar(255)
  deviceName        String?   @map("device_name") @db.VarChar(100)
  userAgent         String?   @map("user_agent") @db.VarChar(500)
  ipLast            String?   @map("ip_last") @db.VarChar(45)
  permissionVersion BigInt    @map("permission_version") @db.UnsignedBigInt
  expiresAt         DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt         DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthRateLimitBucket {
  id           String                 @id @default(uuid()) @db.Char(36)
  dimension    AuthRateLimitDimension
  keyHash      String                 @map("key_hash") @db.Char(64)
  windowStart  DateTime               @map("window_start") @db.DateTime(3)
  attemptCount Int                    @default(0) @map("attempt_count") @db.UnsignedInt
  blockedUntil DateTime?              @map("blocked_until") @db.DateTime(3)
  lastLoggedAt DateTime?              @map("last_logged_at") @db.DateTime(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([dimension, keyHash])
  @@index([blockedUntil])
  @@index([updatedAt])
  @@map("auth_rate_limit_buckets")
}

model Organization {
  id                       String                       @id @default(uuid()) @db.Char(36)
  name                     String                       @db.VarChar(200)
  type                     OrganizationType
  parentId                 String?                      @map("parent_id") @db.Char(36)
  status                   RecordStatus                 @default(ACTIVE)
  phone                    String?                      @db.VarChar(30)
  address                  String?                      @db.VarChar(500)
  latitude                 Decimal?                     @db.Decimal(10, 7)
  longitude                Decimal?                     @db.Decimal(11, 7)
  createdAt                DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)
  parent                   Organization?                @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                 Organization[]               @relation("OrganizationHierarchy")
  areaMappings             OrganizationAreaMapping[]
  appointments             Appointment[]
  departmentAreaRelations  DepartmentTownshipRelation[]
  dispatchBatchMemberships BatchMembership[]            @relation("DispatchOrganization")
  postBatchMemberships     BatchMembership[]            @relation("PostOrganization")

  @@index([parentId])
  @@index([type, status])
  @@index([name])
  @@map("organizations")
}

model AdministrativeArea {
  id                         String                       @id @default(uuid()) @db.Char(36)
  name                       String                       @db.VarChar(200)
  type                       AdministrativeAreaType
  parentId                   String?                      @map("parent_id") @db.Char(36)
  status                     RecordStatus                 @default(ACTIVE)
  sortOrder                  Int                          @default(0) @map("sort_order")
  createdAt                  DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                  DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)
  parent                     AdministrativeArea?          @relation("AdministrativeAreaHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                   AdministrativeArea[]         @relation("AdministrativeAreaHierarchy")
  organizationMappings       OrganizationAreaMapping[]
  departmentRelations        DepartmentTownshipRelation[]
  enterprises                Enterprise[]
  proposedEnterpriseRequests EnterpriseChangeRequest[]
  boundaryVersions           MapBoundaryVersion[]

  @@index([parentId])
  @@index([type, status, sortOrder])
  @@index([name])
  @@map("administrative_areas")
}

model OrganizationAreaMapping {
  id             String             @id @default(uuid()) @db.Char(36)
  organizationId String             @map("organization_id") @db.Char(36)
  areaId         String             @map("area_id") @db.Char(36)
  effectiveAt    DateTime           @map("effective_at") @db.DateTime(3)
  expiredAt      DateTime?          @map("expired_at") @db.DateTime(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  area           AdministrativeArea @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([organizationId, effectiveAt, expiredAt])
  @@index([areaId, effectiveAt, expiredAt])
  @@map("organization_area_mappings")
}

model MapBoundaryVersion {
  id                  String             @id @default(uuid()) @db.Char(36)
  areaId              String             @map("area_id") @db.Char(36)
  versionNo           Int                @map("version_no") @db.UnsignedInt
  geoJson             Json               @map("geo_json")
  checksum            String             @db.Char(64)
  sourceFilename      String?            @map("source_filename") @db.VarChar(255)
  isCurrent           Boolean            @default(false) @map("is_current")
  changeReason        String             @map("change_reason") @db.VarChar(500)
  createdByPersonId   String             @map("created_by_person_id") @db.Char(36)
  createdAt           DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  area                AdministrativeArea @relation(fields: [areaId], references: [id], onDelete: Restrict)
  createdByPerson     Person             @relation("MapBoundaryCreator", fields: [createdByPersonId], references: [id], onDelete: Restrict)

  @@unique([areaId, versionNo])
  @@index([areaId, isCurrent])
  @@index([createdByPersonId, createdAt])
  @@map("map_boundary_versions")
}

model Appointment {
  id             String       @id @default(uuid()) @db.Char(36)
  personId       String       @map("person_id") @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  positionTitle  String       @map("position_title") @db.VarChar(100)
  effectiveAt    DateTime     @map("effective_at") @db.DateTime(3)
  expiredAt      DateTime?    @map("expired_at") @db.DateTime(3)
  isPrimary      Boolean      @default(false) @map("is_primary")
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  person         Person       @relation(fields: [personId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([personId, effectiveAt, expiredAt])
  @@index([organizationId, effectiveAt, expiredAt])
  @@map("appointments")
}

model DepartmentTownshipRelation {
  id                       String             @id @default(uuid()) @db.Char(36)
  departmentOrganizationId String             @map("department_organization_id") @db.Char(36)
  areaId                   String             @map("area_id") @db.Char(36)
  effectiveAt              DateTime           @map("effective_at") @db.DateTime(3)
  expiredAt                DateTime?          @map("expired_at") @db.DateTime(3)
  createdAt                DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  departmentOrganization   Organization       @relation(fields: [departmentOrganizationId], references: [id], onDelete: Restrict)
  area                     AdministrativeArea @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([departmentOrganizationId, effectiveAt, expiredAt])
  @@index([areaId, effectiveAt, expiredAt])
  @@map("department_township_relations")
}

model RoleAssignment {
  id                String    @id @default(uuid()) @db.Char(36)
  personId          String    @map("person_id") @db.Char(36)
  roleCode          RoleCode  @map("role_code")
  effectiveAt       DateTime  @map("effective_at") @db.DateTime(3)
  expiredAt         DateTime? @map("expired_at") @db.DateTime(3)
  grantedByPersonId String?   @map("granted_by_person_id") @db.Char(36)
  reason            String?   @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  person            Person    @relation("RoleAssignmentPerson", fields: [personId], references: [id], onDelete: Restrict)
  grantedByPerson   Person?   @relation("RoleAssignmentGrantor", fields: [grantedByPersonId], references: [id], onDelete: Restrict)

  @@index([personId, effectiveAt, expiredAt])
  @@index([roleCode, effectiveAt, expiredAt])
  @@index([grantedByPersonId])
  @@map("role_assignments")
}

model SpecialPermissionGrant {
  id                String    @id @default(uuid()) @db.Char(36)
  personId          String    @map("person_id") @db.Char(36)
  permissionCode    String    @map("permission_code") @db.VarChar(100)
  effectiveAt       DateTime  @map("effective_at") @db.DateTime(3)
  expiredAt         DateTime? @map("expired_at") @db.DateTime(3)
  reason            String    @db.VarChar(500)
  grantedByPersonId String    @map("granted_by_person_id") @db.Char(36)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  person            Person    @relation("PermissionGrantPerson", fields: [personId], references: [id], onDelete: Restrict)
  grantedByPerson   Person    @relation("PermissionGrantGrantor", fields: [grantedByPersonId], references: [id], onDelete: Restrict)

  @@index([personId, effectiveAt, expiredAt])
  @@index([permissionCode, effectiveAt, expiredAt])
  @@index([grantedByPersonId])
  @@map("special_permission_grants")
}

model Batch {
  id                     String                  @id @default(uuid()) @db.Char(36)
  name                   String                  @db.VarChar(100)
  year                   Int                     @db.UnsignedSmallInt
  startDate              DateTime                @map("start_date") @db.Date
  endDate                DateTime?               @map("end_date") @db.Date
  status                 BatchStatus             @default(PLANNED)
  isCurrent              Boolean                 @default(false) @map("is_current")
  createdAt              DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  memberships            BatchMembership[]
  groupLeaderAssignments GroupLeaderAssignment[]

  @@index([status, isCurrent])
  @@index([year])
  @@map("batches")
}

model BatchMembership {
  id                     String        @id @default(uuid()) @db.Char(36)
  personId               String        @map("person_id") @db.Char(36)
  batchId                String        @map("batch_id") @db.Char(36)
  dispatchOrganizationId String?       @map("dispatch_organization_id") @db.Char(36)
  postOrganizationId     String?       @map("post_organization_id") @db.Char(36)
  positionTitle          String?       @map("position_title") @db.VarChar(100)
  startDate              DateTime      @map("start_date") @db.Date
  endDate                DateTime?     @map("end_date") @db.Date
  status                 String        @db.VarChar(32)
  createdAt              DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  person                 Person        @relation(fields: [personId], references: [id], onDelete: Restrict)
  batch                  Batch         @relation(fields: [batchId], references: [id], onDelete: Restrict)
  dispatchOrganization   Organization? @relation("DispatchOrganization", fields: [dispatchOrganizationId], references: [id], onDelete: Restrict)
  postOrganization       Organization? @relation("PostOrganization", fields: [postOrganizationId], references: [id], onDelete: Restrict)

  @@unique([personId, batchId])
  @@index([batchId, status])
  @@index([dispatchOrganizationId])
  @@index([postOrganizationId])
  @@map("batch_memberships")
}

model GroupLeaderAssignment {
  id                String    @id @default(uuid()) @db.Char(36)
  personId          String    @map("person_id") @db.Char(36)
  batchId           String    @map("batch_id") @db.Char(36)
  effectiveAt       DateTime  @map("effective_at") @db.DateTime(3)
  expiredAt         DateTime? @map("expired_at") @db.DateTime(3)
  grantedByPersonId String    @map("granted_by_person_id") @db.Char(36)
  reason            String    @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  person            Person    @relation("GroupLeaderPerson", fields: [personId], references: [id], onDelete: Restrict)
  batch             Batch     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  grantedByPerson   Person    @relation("GroupLeaderGrantor", fields: [grantedByPersonId], references: [id], onDelete: Restrict)

  @@index([personId, effectiveAt, expiredAt])
  @@index([batchId, effectiveAt, expiredAt])
  @@index([grantedByPersonId])
  @@map("group_leader_assignments")
}

model MemberCapabilityProfile {
  id                       String                      @id @default(uuid()) @db.Char(36)
  personId                 String                      @unique @map("person_id") @db.Char(36)
  professionalDirection    String?                     @map("professional_direction") @db.VarChar(500)
  coordinatableResources   String?                     @map("coordinatable_resources") @db.Text
  personalIntroduction     String?                     @map("personal_introduction") @db.Text
  updatedByPersonId        String                      @map("updated_by_person_id") @db.Char(36)
  createdAt                DateTime                    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime                    @updatedAt @map("updated_at") @db.DateTime(3)
  person                   Person                      @relation("MemberCapabilityPerson", fields: [personId], references: [id], onDelete: Restrict)
  updatedByPerson          Person                      @relation("MemberCapabilityUpdater", fields: [updatedByPersonId], references: [id], onDelete: Restrict)
  industries               MemberCapabilityIndustry[]
  preferredDemandTypes     MemberPreferredDemandType[]

  @@index([updatedByPersonId, updatedAt])
  @@map("member_capability_profiles")
}

model MemberIndustry {
  id             String                      @id @default(uuid()) @db.Char(36)
  name           String                      @unique @db.VarChar(100)
  status         RecordStatus                @default(ACTIVE)
  createdAt      DateTime                    @default(now()) @map("created_at") @db.DateTime(3)
  capabilityUses MemberCapabilityIndustry[]

  @@index([status, name])
  @@map("member_industries")
}

model MemberCapabilityIndustry {
  personId  String                  @map("person_id") @db.Char(36)
  industryId String                 @map("industry_id") @db.Char(36)
  createdAt DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  profile   MemberCapabilityProfile @relation(fields: [personId], references: [personId], onDelete: Restrict)
  industry  MemberIndustry          @relation(fields: [industryId], references: [id], onDelete: Restrict)

  @@id([personId, industryId])
  @@index([industryId, personId])
  @@map("member_capability_industries")
}

model MemberPreferredDemandType {
  personId  String                  @map("person_id") @db.Char(36)
  demandType MemberDemandType       @map("demand_type")
  createdAt DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  profile   MemberCapabilityProfile @relation(fields: [personId], references: [personId], onDelete: Restrict)

  @@id([personId, demandType])
  @@index([demandType, personId])
  @@map("member_preferred_demand_types")
}

model BusinessSequence {
  id           String   @id @default(uuid()) @db.Char(36)
  prefix       String   @db.VarChar(10)
  year         Int      @db.UnsignedSmallInt
  currentValue BigInt   @default(0) @map("current_value") @db.UnsignedBigInt
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([prefix, year])
  @@map("business_sequences")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Char(36)
  actorPersonId  String?  @map("actor_person_id") @db.Char(36)
  actorAccountId String?  @map("actor_account_id") @db.Char(36)
  actionCode     String   @map("action_code") @db.VarChar(100)
  entityType     String   @map("entity_type") @db.VarChar(100)
  entityId       String?  @map("entity_id") @db.Char(36)
  beforeJson     Json?    @map("before_json")
  afterJson      Json?    @map("after_json")
  reason         String?  @db.VarChar(500)
  ip             String?  @db.VarChar(45)
  device         String?  @db.VarChar(255)
  requestId      String?  @map("request_id") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  actorPerson    Person?  @relation(fields: [actorPersonId], references: [id], onDelete: Restrict)
  actorAccount   Account? @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@index([actorPersonId, createdAt])
  @@index([actorAccountId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([requestId])
  @@index([createdAt])
  @@map("audit_logs")
}

model StateTransitionHistory {
  id            String   @id @default(uuid()) @db.Char(36)
  entityType    String   @map("entity_type") @db.VarChar(100)
  entityId      String   @map("entity_id") @db.Char(36)
  fromState     String?  @map("from_state") @db.VarChar(100)
  toState       String   @map("to_state") @db.VarChar(100)
  actionCode    String   @map("action_code") @db.VarChar(100)
  actorPersonId String?  @map("actor_person_id") @db.Char(36)
  reason        String?  @db.VarChar(500)
  metadataJson  Json?    @map("metadata_json")
  requestId     String?  @map("request_id") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  actorPerson   Person?  @relation(fields: [actorPersonId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorPersonId, createdAt])
  @@index([requestId])
  @@map("state_transition_history")
}

model PresenceReport {
  id                  String   @id @default(uuid()) @db.Char(36)
  personId            String   @map("person_id") @db.Char(36)
  arrivalAt           DateTime @map("arrival_at") @db.DateTime(3)
  expectedDepartureAt DateTime @map("expected_departure_at") @db.DateTime(3)
  origin              String?  @db.VarChar(200)
  transportMode       String?  @map("transport_mode") @db.VarChar(100)
  trainFlightNo       String?  @map("train_flight_no") @db.VarChar(100)
  note                String?  @db.VarChar(1000)
  canceledAt          DateTime? @map("canceled_at") @db.DateTime(3)
  cancelReason        String?  @map("cancel_reason") @db.VarChar(500)
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  person              Person   @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([personId, canceledAt, arrivalAt, expectedDepartureAt], map: "presence_person_active_interval_idx")
  @@index([arrivalAt, expectedDepartureAt], map: "presence_current_interval_idx")
  @@map("presence_reports")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Char(36)
  eventType     String    @map("event_type") @db.VarChar(100)
  aggregateType String    @map("aggregate_type") @db.VarChar(100)
  aggregateId   String    @map("aggregate_id") @db.Char(36)
  payloadJson   Json      @map("payload_json")
  dedupeKey     String?   @unique @map("dedupe_key") @db.VarChar(191)
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.DateTime(3)
  publishedAt   DateTime? @map("published_at") @db.DateTime(3)
  nextAttemptAt DateTime? @map("next_attempt_at") @db.DateTime(3)
  failedAt      DateTime? @map("failed_at") @db.DateTime(3)
  attempts      Int       @default(0) @db.UnsignedInt
  lastError     String?   @map("last_error") @db.Text

  @@index([publishedAt, occurredAt])
  @@index([publishedAt, failedAt, nextAttemptAt, occurredAt], map: "outbox_consume_retry_idx")
  @@index([aggregateType, aggregateId, occurredAt])
  @@map("outbox_events")
}

model JobTask {
  id             String    @id @default(uuid()) @db.Char(36)
  jobType        String    @map("job_type") @db.VarChar(100)
  payloadJson    Json      @map("payload_json")
  status         JobStatus @default(WAITING)
  priority       Int       @default(0)
  idempotencyKey String    @unique @map("idempotency_key") @db.VarChar(191)
  scheduledAt    DateTime  @map("scheduled_at") @db.DateTime(3)
  lockedAt       DateTime? @map("locked_at") @db.DateTime(3)
  lockedBy       String?   @map("locked_by") @db.VarChar(100)
  retryCount     Int       @default(0) @map("retry_count") @db.UnsignedInt
  maxRetries     Int       @default(3) @map("max_retries") @db.UnsignedInt
  finishedAt     DateTime? @map("finished_at") @db.DateTime(3)
  lastError      String?   @map("last_error") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([status, scheduledAt, priority])
  @@index([lockedAt])
  @@map("job_tasks")
}

model Attachment {
  id                 String                    @id @default(uuid()) @db.Char(36)
  originalFilename   String                    @map("original_filename") @db.VarChar(255)
  extension          String                    @db.VarChar(16)
  declaredMimeType   String                    @map("declared_mime_type") @db.VarChar(191)
  detectedMimeType   String?                   @map("detected_mime_type") @db.VarChar(191)
  detectedFileType   String?                   @map("detected_file_type") @db.VarChar(32)
  expectedSizeBytes  BigInt                    @map("expected_size_bytes") @db.UnsignedBigInt
  actualSizeBytes    BigInt?                   @map("actual_size_bytes") @db.UnsignedBigInt
  sha256             String?                   @db.Char(64)
  storageProvider    AttachmentStorageProvider @default(TENCENT_COS) @map("storage_provider")
  bucket             String                    @db.VarChar(255)
  region             String                    @db.VarChar(64)
  stagingObjectKey   String?                   @map("staging_object_key") @db.VarChar(1024)
  objectKey          String?                   @map("object_key") @db.VarChar(1024)
  uploadStatus       AttachmentUploadStatus    @default(PENDING_UPLOAD) @map("upload_status")
  scanStatus         AttachmentScanStatus      @default(PENDING) @map("scan_status")
  scanReason         String?                   @map("scan_reason") @db.VarChar(255)
  isTemporary        Boolean                   @default(true) @map("is_temporary")
  permissionLevel    AttachmentPermissionLevel @default(PARENT_AUTHORIZED) @map("permission_level")
  uploadedByPersonId String                    @map("uploaded_by_person_id") @db.Char(36)
  uploadExpiresAt    DateTime?                 @map("upload_expires_at") @db.DateTime(3)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)
  uploadedByPerson   Person                    @relation("AttachmentUploader", fields: [uploadedByPersonId], references: [id], onDelete: Restrict)
  links              AttachmentLink[]
  accessLogs         AttachmentAccessLog[]

  @@index([uploadedByPersonId, isTemporary, uploadStatus])
  @@index([uploadStatus, scanStatus])
  @@index([uploadExpiresAt, isTemporary])
  @@index([sha256])
  @@map("attachments")
}

model AttachmentLink {
  id                String     @id @default(uuid()) @db.Char(36)
  attachmentId      String     @map("attachment_id") @db.Char(36)
  entityType        String     @map("entity_type") @db.VarChar(100)
  entityId          String     @map("entity_id") @db.Char(36)
  relationType      String     @map("relation_type") @db.VarChar(100)
  createdByPersonId String     @map("created_by_person_id") @db.Char(36)
  createdAt         DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  attachment        Attachment @relation(fields: [attachmentId], references: [id], onDelete: Restrict)
  createdByPerson   Person     @relation("AttachmentLinkCreator", fields: [createdByPersonId], references: [id], onDelete: Restrict)

  @@unique([attachmentId, entityType, entityId, relationType])
  @@index([entityType, entityId])
  @@index([createdByPersonId, createdAt])
  @@map("attachment_links")
}

model AttachmentAccessLog {
  id           String                 @id @default(uuid()) @db.Char(36)
  attachmentId String                 @map("attachment_id") @db.Char(36)
  personId     String                 @map("person_id") @db.Char(36)
  action       AttachmentAccessAction
  ip           String                 @db.VarChar(45)
  device       String?                @db.VarChar(255)
  requestId    String?                @map("request_id") @db.VarChar(100)
  createdAt    DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  attachment   Attachment             @relation(fields: [attachmentId], references: [id], onDelete: Restrict)
  person       Person                 @relation("AttachmentAccessPerson", fields: [personId], references: [id], onDelete: Restrict)

  @@index([attachmentId, createdAt])
  @@index([personId, createdAt])
  @@index([requestId])
  @@map("attachment_access_logs")
}

model Enterprise {
  id                     String                    @id @default(uuid()) @db.Char(36)
  name                   String                    @db.VarChar(200)
  responsibleAreaId      String                    @map("responsible_area_id") @db.Char(36)
  address                String                    @db.VarChar(500)
  creditCode             String?                   @unique @map("credit_code") @db.VarChar(32)
  legalRepresentative    String?                   @map("legal_representative") @db.VarChar(80)
  introduction           String?                   @db.Text
  mainProducts           String                    @map("main_products") @db.Text
  qualificationsHonors   String?                   @map("qualifications_honors") @db.Text
  latitude               Decimal?                  @db.Decimal(10, 7)
  longitude              Decimal?                  @db.Decimal(11, 7)
  geocodeStatus          EnterpriseGeocodeStatus   @default(UNRESOLVED) @map("geocode_status")
  geocodeProvider        String?                   @map("geocode_provider") @db.VarChar(64)
  geocodedAt             DateTime?                 @map("geocoded_at") @db.DateTime(3)
  coordinateUpdatedById  String?                   @map("coordinate_updated_by_id") @db.Char(36)
  status                 EnterpriseStatus          @default(NORMAL)
  mergedIntoId           String?                   @map("merged_into_id") @db.Char(36)
  primaryContactId       String?                   @unique @map("primary_contact_id") @db.Char(36)
  currentVersion         Int                       @default(1) @map("current_version") @db.UnsignedInt
  createdByPersonId      String?                   @map("created_by_person_id") @db.Char(36)
  createdAt              DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)
  responsibleArea        AdministrativeArea        @relation(fields: [responsibleAreaId], references: [id], onDelete: Restrict)
  mergedInto             Enterprise?               @relation("EnterpriseMergeTarget", fields: [mergedIntoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mergedSources          Enterprise[]              @relation("EnterpriseMergeTarget")
  primaryContact         EnterpriseContact?        @relation("EnterprisePrimaryContact", fields: [primaryContactId], references: [id], onDelete: Restrict)
  contacts               EnterpriseContact[]       @relation("EnterpriseContacts")
  versions               EnterpriseVersion[]
  tagRelations           EnterpriseTagRelation[]
  targetChangeRequests   EnterpriseChangeRequest[] @relation("EnterpriseRequestTarget")
  approvedChangeRequests EnterpriseChangeRequest[] @relation("EnterpriseRequestApproved")
  createdByPerson        Person?                   @relation("EnterpriseCreator", fields: [createdByPersonId], references: [id], onDelete: Restrict)
  coordinateUpdatedBy    Person?                   @relation("EnterpriseCoordinateUpdater", fields: [coordinateUpdatedById], references: [id], onDelete: Restrict)

  @@index([status, responsibleAreaId])
  @@index([name])
  @@index([mergedIntoId])
  @@map("enterprises")
}

model EnterpriseTag {
  id             String                  @id @default(uuid()) @db.Char(36)
  name           String                  @db.VarChar(100)
  normalizedName String                  @unique @map("normalized_name") @db.VarChar(100)
  status         RecordStatus            @default(ACTIVE)
  createdAt      DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  relations      EnterpriseTagRelation[]

  @@index([status, name])
  @@map("enterprise_tags")
}

model EnterpriseTagRelation {
  enterpriseId String        @map("enterprise_id") @db.Char(36)
  tagId        String        @map("tag_id") @db.Char(36)
  createdAt    DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  enterprise   Enterprise    @relation(fields: [enterpriseId], references: [id], onDelete: Restrict)
  tag          EnterpriseTag @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([enterpriseId, tagId])
  @@index([tagId, enterpriseId])
  @@map("enterprise_tag_relations")
}

model EnterpriseContact {
  id                String                  @id @default(uuid()) @db.Char(36)
  enterpriseId      String                  @map("enterprise_id") @db.Char(36)
  name              String                  @db.VarChar(80)
  positionTitle     String?                 @map("position_title") @db.VarChar(100)
  phone             String                  @db.VarChar(30)
  isPrimary         Boolean                 @default(false) @map("is_primary")
  status            EnterpriseContactStatus @default(ACTIVE)
  createdByPersonId String                  @map("created_by_person_id") @db.Char(36)
  inactiveReason    String?                 @map("inactive_reason") @db.VarChar(500)
  createdAt         DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  enterprise        Enterprise              @relation("EnterpriseContacts", fields: [enterpriseId], references: [id], onDelete: Restrict)
  primaryFor        Enterprise?             @relation("EnterprisePrimaryContact")
  createdByPerson   Person                  @relation(fields: [createdByPersonId], references: [id], onDelete: Restrict)

  @@index([enterpriseId, status])
  @@index([phone])
  @@map("enterprise_contacts")
}

model EnterpriseChangeRequest {
  id                    String                        @id @default(uuid()) @db.Char(36)
  requestType           EnterpriseChangeRequestType   @map("request_type")
  proposedAreaId        String?                       @map("proposed_area_id") @db.Char(36)
  targetEnterpriseId    String?                       @map("target_enterprise_id") @db.Char(36)
  payloadSnapshot       Json                          @map("payload_snapshot")
  baseEnterpriseVersion Int?                          @map("base_enterprise_version") @db.UnsignedInt
  submitterPersonId     String                        @map("submitter_person_id") @db.Char(36)
  status                EnterpriseChangeRequestStatus @default(PENDING_REVIEW)
  reviewerPersonId      String?                       @map("reviewer_person_id") @db.Char(36)
  reviewReason          String?                       @map("review_reason") @db.VarChar(500)
  approvedEnterpriseId  String?                       @map("approved_enterprise_id") @db.Char(36)
  submittedAt           DateTime                      @default(now()) @map("submitted_at") @db.DateTime(3)
  reviewedAt            DateTime?                     @map("reviewed_at") @db.DateTime(3)
  createdAt             DateTime                      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime                      @updatedAt @map("updated_at") @db.DateTime(3)
  proposedArea          AdministrativeArea?           @relation(fields: [proposedAreaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetEnterprise      Enterprise?                   @relation("EnterpriseRequestTarget", fields: [targetEnterpriseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedEnterprise    Enterprise?                   @relation("EnterpriseRequestApproved", fields: [approvedEnterpriseId], references: [id], onDelete: Restrict)
  submitterPerson       Person                        @relation("EnterpriseRequestSubmitter", fields: [submitterPersonId], references: [id], onDelete: Restrict)
  reviewerPerson        Person?                       @relation("EnterpriseRequestReviewer", fields: [reviewerPersonId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([submitterPersonId, status])
  @@index([targetEnterpriseId])
  @@map("enterprise_change_requests")
}

model EnterpriseVersion {
  id                String                      @id @default(uuid()) @db.Char(36)
  enterpriseId      String                      @map("enterprise_id") @db.Char(36)
  versionNo         Int                         @map("version_no") @db.UnsignedInt
  snapshotJson      Json                        @map("snapshot_json")
  changeType        EnterpriseVersionChangeType @map("change_type")
  reason            String?                     @db.VarChar(500)
  changedByPersonId String                      @map("changed_by_person_id") @db.Char(36)
  createdAt         DateTime                    @default(now()) @map("created_at") @db.DateTime(3)
  enterprise        Enterprise                  @relation(fields: [enterpriseId], references: [id], onDelete: Restrict)
  changedByPerson   Person                      @relation(fields: [changedByPersonId], references: [id], onDelete: Restrict)

  @@unique([enterpriseId, versionNo])
  @@index([changedByPersonId, createdAt])
  @@map("enterprise_versions")
}
