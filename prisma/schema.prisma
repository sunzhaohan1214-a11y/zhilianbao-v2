model Person {
  id                             String                       @id @default(uuid()) @db.Char(36)
  name                           String                       @db.VarChar(80)
  contactPhone                   String?                      @map("contact_phone") @db.VarChar(30)
  personStatus                   PersonStatus                 @default(ACTIVE) @map("person_status")
  createdAt                      DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                      DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)
  account                        Account?
  phoneChanges                   AccountPhoneHistory[]        @relation("PhoneChangeAccount")
  appointments                   Appointment[]
  roleAssignments                RoleAssignment[]             @relation("RoleAssignmentPerson")
  grantedRoleAssignments         RoleAssignment[]             @relation("RoleAssignmentGrantor")
  specialPermissionGrants        SpecialPermissionGrant[]     @relation("PermissionGrantPerson")
  grantedSpecialPermissions      SpecialPermissionGrant[]     @relation("PermissionGrantGrantor")
  batchMemberships               BatchMembership[]
  groupLeaderAssignments         GroupLeaderAssignment[]      @relation("GroupLeaderPerson")
  grantedGroupLeaderAssignments  GroupLeaderAssignment[]      @relation("GroupLeaderGrantor")
  memberCapabilityProfile        MemberCapabilityProfile?     @relation("MemberCapabilityPerson")
  updatedMemberCapabilities      MemberCapabilityProfile[]    @relation("MemberCapabilityUpdater")
  auditLogs                      AuditLog[]
  stateTransitions               StateTransitionHistory[]
  uploadedAttachments            Attachment[]                 @relation("AttachmentUploader")
  createdAttachmentLinks         AttachmentLink[]             @relation("AttachmentLinkCreator")
  attachmentAccessLogs           AttachmentAccessLog[]        @relation("AttachmentAccessPerson")
  createdEnterprises             Enterprise[]                 @relation("EnterpriseCreator")
  coordinatedEnterprises         Enterprise[]                 @relation("EnterpriseCoordinateUpdater")
  createdEnterpriseContacts      EnterpriseContact[]
  submittedEnterpriseRequests    EnterpriseChangeRequest[]    @relation("EnterpriseRequestSubmitter")
  reviewedEnterpriseRequests     EnterpriseChangeRequest[]    @relation("EnterpriseRequestReviewer")
  enterpriseVersions             EnterpriseVersion[]
  presenceReports                PresenceReport[]
  createdPolicies                Policy[]                     @relation("PolicyCreator")
  changedPolicyVersions          PolicyContentVersion[]       @relation("PolicyVersionChanger")
  confirmedPolicyVersions        PolicyContentVersion[]       @relation("PolicyVersionConfirmer")
  confirmedPolicyInterpretations PolicyAIInterpretation[]     @relation("PolicyInterpretationConfirmer")
  createdPolicyReplacements      PolicyReplacementRelation[]  @relation("PolicyReplacementCreator")
  endedPolicyReplacements        PolicyReplacementRelation[]  @relation("PolicyReplacementEnder")
  sourcedDemandLeads             DemandLead[]                 @relation("DemandLeadSourcePerson")
  createdDemandLeads             DemandLead[]                 @relation("DemandLeadCreator")
  demandLeadSupplements          DemandLeadSupplement[]
  createdDemands                 Demand[]                     @relation("DemandCreator")
  createdMapBoundaryVersions     MapBoundaryVersion[]         @relation("MapBoundaryCreator")
  createdTrips                   Trip[]                       @relation("TripCreator")
  canceledTrips                  Trip[]                       @relation("TripCanceler")
  tripParticipations             TripParticipant[]            @relation("TripParticipantPerson")
  addedTripParticipations        TripParticipant[]            @relation("TripParticipantAdder")
  submittedTripResults           TripResult[]                 @relation("TripResultSubmitter")
  visitSupplements               VisitSupplement[]            @relation("VisitSupplementCreator")
  tripIdempotencyRecords         TripIdempotency[]            @relation("TripIdempotencyActor")
  visitLeadIdempotencyRecords    VisitDemandLeadIdempotency[] @relation("VisitLeadIdempotencyActor")
  createdTalents                 Talent[]                     @relation("TalentCreator")
  recommendedTalents             Talent[]                     @relation("TalentOriginalRecommender")
  contactedTalents               Talent[]                     @relation("TalentCurrentContact")
  submittedTalentRequests        TalentChangeRequest[]        @relation("TalentRequestSubmitter")
  reviewedTalentRequests         TalentChangeRequest[]        @relation("TalentRequestReviewer")
  changedTalentVersions          TalentVersion[]              @relation("TalentVersionChanger")
  talentContactHistories         TalentContactPersonHistory[] @relation("TalentContactPerson")
  changedTalentContacts          TalentContactPersonHistory[] @relation("TalentContactChanger")
  startedTalentRounds            TalentTownshipRound[]        @relation("TalentRoundStarter")
  handledTalentRounds            TalentTownshipRound[]        @relation("TalentRoundHandler")
  voidedTalentRounds             TalentTownshipRound[]        @relation("TalentRoundVoider")
  talentRoundProgresses          TalentTownshipProgress[]     @relation("TalentProgressCreator")
  requestedTalentAIExtractions   TalentAIExtraction[]         @relation("TalentAIRequester")
  confirmedTalentAIExtractions   TalentAIExtraction[]         @relation("TalentAIConfirmer")
  submittedHelpRequests          HelpRequest[]                 @relation("HelpSubmitter")
  ownedHelpRequests              HelpRequest[]                 @relation("HelpCurrentOwner")
  helpAssignments                HelpAssignmentHistory[]       @relation("HelpAssignmentPerson")
  changedHelpAssignments         HelpAssignmentHistory[]       @relation("HelpAssignmentChanger")
  helpProgresses                 HelpProgress[]                @relation("HelpProgressCreator")
  helpCommandIdempotencies       HelpCommandIdempotency[]      @relation("HelpIdempotencyActor")
  reimbursements                 Reimbursement[]               @relation("ReimbursementApplicant")
  submittedReimbursementVersions ReimbursementSubmissionVersion[] @relation("ReimbursementVersionSubmitter")
  confirmedReimbursementInvoices ReimbursementInvoice[]       @relation("ReimbursementInvoiceConfirmer")
  receivedReimbursements         Reimbursement[]               @relation("ReimbursementPaperReceiver")
  financeSubmittedReimbursements Reimbursement[]               @relation("ReimbursementFinanceSubmitter")
  reimbursementIdempotencies     ReimbursementCommandIdempotency[] @relation("ReimbursementIdempotencyActor")
  reimbursementExports           ReimbursementExportTask[]     @relation("ReimbursementExportCreator")
  reviewedDemands                Demand[]                      @relation("DemandReviewer")
  publishedDemands               Demand[]                      @relation("DemandPublisher")
  demandReviews                  DemandReview[]
  demandCommandIdempotencies     DemandCommandIdempotency[]
  createdAnnouncements           Announcement[]               @relation("AnnouncementCreator")
  publishedAnnouncements         Announcement[]               @relation("AnnouncementPublisher")
  withdrawnAnnouncements         Announcement[]               @relation("AnnouncementWithdrawer")
  createdAnnouncementVersions    AnnouncementVersion[]        @relation("AnnouncementVersionCreator")
  targetedAnnouncementRules      AnnouncementAudienceRule[]   @relation("AnnouncementAudiencePerson")
  createdAnnouncementRules       AnnouncementAudienceRule[]   @relation("AnnouncementAudienceCreator")
  announcementRecipientStates    AnnouncementRecipientState[]
  messages                       Message[]
  todos                          Todo[]
  currentlyOwnedDemands          Demand[]                     @relation("DemandCurrentOwner")
  demandOwnerHistories           DemandOwnerHistory[]         @relation("DemandOwnerPerson")
  createdDemandOwnerHistories    DemandOwnerHistory[]         @relation("DemandOwnerHistoryCreator")
  demandCollaborationRequests    DemandCollaborationRequest[] @relation("DemandCollaborationTarget")
  requestedDemandCollaborations  DemandCollaborationRequest[] @relation("DemandCollaborationRequester")
  decidedDemandCollaborations    DemandCollaborationRequest[] @relation("DemandCollaborationDecider")
  demandCollaborations           DemandCollaborator[]         @relation("DemandCollaboratorPerson")
  endedDemandCollaborations      DemandCollaborator[]         @relation("DemandCollaboratorEnder")
  createdRecommendationRuns      DemandRecommendationRun[]    @relation("RecommendationRunCreator")
  recommendationItems            DemandRecommendationItem[]   @relation("RecommendationCandidate")
  recommendationResponses        DemandRecommendationItem[]   @relation("RecommendationResponder")
  alumniHelpAssignments          DemandAlumniHelper[]          @relation("DemandAlumniHelperPerson")
  createdAlumniHelpAssignments   DemandAlumniHelper[]          @relation("DemandAlumniHelperCreator")
  townshipHandlerAssignments     DemandTownshipHandler[]       @relation("DemandTownshipHandlerPerson")
  assignedTownshipHandlers       DemandTownshipHandler[]       @relation("DemandTownshipHandlerAssigner")
  demandProgresses               DemandProgress[]              @relation("DemandProgressCreator")
  representedDemandProgresses    DemandProgress[]              @relation("DemandProgressRepresentedPerson")
  sentDemandProgressReminders    DemandProgressReminder[]      @relation("DemandProgressReminderSender")
  receivedDemandProgressReminders DemandProgressReminder[]     @relation("DemandProgressReminderRecipient")
  submittedDemandCloseRequests   DemandCloseRequest[]          @relation("DemandCloseRequestSubmitter")
  handledDemandCloseRequests     DemandCloseRequest[]          @relation("DemandCloseRequestTownshipHandler")
  reviewedDemandCloseRequests    DemandCloseReview[]           @relation("DemandCloseReviewer")
  requestedDemandOwnerExits      DemandOwnerExitRequest[]      @relation("DemandOwnerExitOwner")
  reviewedDemandOwnerExits       DemandOwnerExitRequest[]      @relation("DemandOwnerExitReviewer")

  @@index([personStatus])
  @@map("persons")
}

model Account {
  id                         String                @id @default(uuid()) @db.Char(36)
  personId                   String                @unique @map("person_id") @db.Char(36)
  phone                      String                @unique @db.VarChar(20)
  passwordHash               String                @map("password_hash") @db.VarChar(255)
  status                     AccountStatus         @default(PENDING_ENABLE)
  forcePasswordChange        Boolean               @default(false) @map("force_password_change")
  firstPasswordChangedAt     DateTime?             @map("first_password_changed_at") @db.DateTime(3)
  confidentialityConfirmedAt DateTime?             @map("confidentiality_confirmed_at") @db.DateTime(3)
  permissionVersion          BigInt                @default(1) @map("permission_version") @db.UnsignedBigInt
  lastLoginAt                DateTime?             @map("last_login_at") @db.DateTime(3)
  createdAt                  DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                  DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  person                     Person                @relation(fields: [personId], references: [id], onDelete: Restrict)
  phoneHistory               AccountPhoneHistory[]
  sessions                   Session[]
  auditLogs                  AuditLog[]

  @@index([status])
  @@map("accounts")
}

model AccountPhoneHistory {
  id                String   @id @default(uuid()) @db.Char(36)
  accountId         String   @map("account_id") @db.Char(36)
  oldPhone          String   @map("old_phone") @db.VarChar(20)
  newPhone          String   @map("new_phone") @db.VarChar(20)
  reason            String   @db.VarChar(500)
  changedByPersonId String   @map("changed_by_person_id") @db.Char(36)
  changedAt         DateTime @default(now()) @map("changed_at") @db.DateTime(3)
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  changedByPerson   Person   @relation("PhoneChangeAccount", fields: [changedByPersonId], references: [id], onDelete: Restrict)

  @@index([accountId, changedAt])
  @@index([changedByPersonId, changedAt])
  @@map("account_phone_history")
}

model Session {
  id                String    @id @default(uuid()) @db.Char(36)
  accountId         String    @map("account_id") @db.Char(36)
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  deviceId          String    @map("device_id") @db.VarChar(255)
  deviceName        String?   @map("device_name") @db.VarChar(100)
  userAgent         String?   @map("user_agent") @db.VarChar(500)
  ipLast            String?   @map("ip_last") @db.VarChar(45)
  permissionVersion BigInt    @map("permission_version") @db.UnsignedBigInt
  expiresAt         DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt         DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthRateLimitBucket {
  id           String                 @id @default(uuid()) @db.Char(36)
  dimension    AuthRateLimitDimension
  keyHash      String                 @map("key_hash") @db.Char(64)
  windowStart  DateTime               @map("window_start") @db.DateTime(3)
  attemptCount Int                    @default(0) @map("attempt_count") @db.UnsignedInt
  blockedUntil DateTime?              @map("blocked_until") @db.DateTime(3)
  lastLoggedAt DateTime?              @map("last_logged_at") @db.DateTime(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([dimension, keyHash])
  @@index([blockedUntil])
  @@index([updatedAt])
  @@map("auth_rate_limit_buckets")
}

model Organization {
  id                       String                       @id @default(uuid()) @db.Char(36)
  name                     String                       @db.VarChar(200)
  type                     OrganizationType
  parentId                 String?                      @map("parent_id") @db.Char(36)
  status                   RecordStatus                 @default(ACTIVE)
  phone                    String?                      @db.VarChar(30)
  address                  String?                      @db.VarChar(500)
  latitude                 Decimal?                     @db.Decimal(10, 7)
  longitude                Decimal?                     @db.Decimal(11, 7)
  createdAt                DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)
  parent                   Organization?                @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                 Organization[]               @relation("OrganizationHierarchy")
  areaMappings             OrganizationAreaMapping[]
  appointments             Appointment[]
  departmentAreaRelations  DepartmentTownshipRelation[]
  dispatchBatchMemberships BatchMembership[]            @relation("DispatchOrganization")
  postBatchMemberships     BatchMembership[]            @relation("PostOrganization")
  transferredHelpRequests  HelpRequest[]                 @relation("HelpTransferredOrganization")
  helpAssignments          HelpAssignmentHistory[]       @relation("HelpAssignmentOrganization")
  demandTownshipHandlers   DemandTownshipHandler[]
  announcementAudienceRules AnnouncementAudienceRule[]

  @@index([parentId])
  @@index([type, status])
  @@index([name])
  @@map("organizations")
}

model AdministrativeArea {
  id                         String                       @id @default(uuid()) @db.Char(36)
  name                       String                       @db.VarChar(200)
  type                       AdministrativeAreaType
  parentId                   String?                      @map("parent_id") @db.Char(36)
  status                     RecordStatus                 @default(ACTIVE)
  sortOrder                  Int                          @default(0) @map("sort_order")
  createdAt                  DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                  DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)
  parent                     AdministrativeArea?          @relation("AdministrativeAreaHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                   AdministrativeArea[]         @relation("AdministrativeAreaHierarchy")
  organizationMappings       OrganizationAreaMapping[]
  departmentRelations        DepartmentTownshipRelation[]
  enterprises                Enterprise[]
  proposedEnterpriseRequests EnterpriseChangeRequest[]
  boundaryVersions           MapBoundaryVersion[]
  publicAttachments          Attachment[]                 @relation("PublicAttachmentArea")
  demandLeads                DemandLead[]
  demands                    Demand[]
  talentTownshipRounds       TalentTownshipRound[]
  announcementAudienceRules  AnnouncementAudienceRule[]

  @@index([parentId])
  @@index([type, status, sortOrder])
  @@index([name])
  @@map("administrative_areas")
}

model OrganizationAreaMapping {
  id             String             @id @default(uuid()) @db.Char(36)
  organizationId String             @map("organization_id") @db.Char(36)
  areaId         String             @map("area_id") @db.Char(36)
  effectiveAt    DateTime           @map("effective_at") @db.DateTime(3)
  expiredAt      DateTime?          @map("expired_at") @db.DateTime(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  area           AdministrativeArea @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([organizationId, effectiveAt, expiredAt])
  @@index([areaId, effectiveAt, expiredAt])
  @@map("organization_area_mappings")
}

model MapBoundaryVersion {
  id                String             @id @default(uuid()) @db.Char(36)
  areaId            String             @map("area_id") @db.Char(36)
  versionNo         Int                @map("version_no") @db.UnsignedInt
  geoJson           Json               @map("geo_json")
  checksum          String             @db.Char(64)
  sourceFilename    String?            @map("source_filename") @db.VarChar(255)
  isCurrent         Boolean            @default(false) @map("is_current")
  changeReason      String             @map("change_reason") @db.VarChar(500)
  createdByPersonId String             @map("created_by_person_id") @db.Char(36)
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  area              AdministrativeArea @relation(fields: [areaId], references: [id], onDelete: Restrict)
  createdByPerson   Person             @relation("MapBoundaryCreator", fields: [createdByPersonId], references: [id], onDelete: Restrict)

  @@unique([areaId, versionNo])
  @@index([areaId, isCurrent])
  @@index([createdByPersonId, createdAt])
  @@map("map_boundary_versions")
}

model Appointment {
  id             String       @id @default(uuid()) @db.Char(36)
  personId       String       @map("person_id") @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  positionTitle  String       @map("position_title") @db.VarChar(100)
  effectiveAt    DateTime     @map("effective_at") @db.DateTime(3)
  expiredAt      DateTime?    @map("expired_at") @db.DateTime(3)
  isPrimary      Boolean      @default(false) @map("is_primary")
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  person         Person       @relation(fields: [personId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([personId, effectiveAt, expiredAt])
  @@index([organizationId, effectiveAt, expiredAt])
  @@map("appointments")
}

model DepartmentTownshipRelation {
  id                       String             @id @default(uuid()) @db.Char(36)
  departmentOrganizationId String             @map("department_organization_id") @db.Char(36)
