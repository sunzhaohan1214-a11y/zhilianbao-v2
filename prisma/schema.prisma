  roleCode          RoleCode?                    @map("role_code")
  areaId            String?                      @map("area_id") @db.Char(36)
  organizationId    String?                      @map("organization_id") @db.Char(36)
  personId          String?                      @map("person_id") @db.Char(36)
  effectiveAt       DateTime                     @map("effective_at") @db.DateTime(3)
  expiredAt         DateTime?                    @map("expired_at") @db.DateTime(3)
  createdByPersonId String                       @map("created_by_person_id") @db.Char(36)
  createdAt         DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  announcement      Announcement                 @relation(fields: [announcementId], references: [id], onDelete: Restrict)
  area              AdministrativeArea?          @relation(fields: [areaId], references: [id], onDelete: Restrict)
  organization      Organization?                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  person            Person?                      @relation("AnnouncementAudiencePerson", fields: [personId], references: [id], onDelete: Restrict)
  createdByPerson   Person                       @relation("AnnouncementAudienceCreator", fields: [createdByPersonId], references: [id], onDelete: Restrict)

  @@index([announcementId, effectiveAt, expiredAt])
  @@index([audienceType, roleCode, areaId, organizationId, personId])
  @@map("announcement_audience_rules")
}

model AnnouncementRecipientState {
  id          String              @id @default(uuid()) @db.Char(36)
  versionId   String              @map("version_id") @db.Char(36)
  personId    String              @map("person_id") @db.Char(36)
  readAt      DateTime?           @map("read_at") @db.DateTime(3)
  confirmedAt DateTime?           @map("confirmed_at") @db.DateTime(3)
  revokedAt   DateTime?           @map("revoked_at") @db.DateTime(3)
  createdAt   DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  version     AnnouncementVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  person      Person              @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([versionId, personId])
  @@index([personId, revokedAt, confirmedAt])
  @@map("announcement_recipient_states")
}

model Message {
  id            String   @id @default(uuid()) @db.Char(36)
  personId      String   @map("person_id") @db.Char(36)
  messageType   String   @map("message_type") @db.VarChar(100)
  title         String   @db.VarChar(200)
  summary       String   @db.VarChar(500)
  aggregateType String?  @map("aggregate_type") @db.VarChar(100)
  aggregateId   String?  @map("aggregate_id") @db.Char(36)
  actionUrl     String?  @map("action_url") @db.VarChar(500)
  dedupeKey     String   @unique @map("dedupe_key") @db.VarChar(191)
  eventAt       DateTime @map("event_at") @db.DateTime(3)
  readAt        DateTime? @map("read_at") @db.DateTime(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  person        Person   @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([personId, readAt, eventAt])
  @@index([aggregateType, aggregateId])
  @@map("messages")
}

model Todo {
  id            String     @id @default(uuid()) @db.Char(36)
  personId      String     @map("person_id") @db.Char(36)
  todoType      String     @map("todo_type") @db.VarChar(100)
  module        String     @db.VarChar(100)
  aggregateType String     @map("aggregate_type") @db.VarChar(100)
  aggregateId   String     @map("aggregate_id") @db.Char(36)
  actionUrl     String     @map("action_url") @db.VarChar(500)
  dedupeKey     String     @unique @map("dedupe_key") @db.VarChar(191)
  eventKey      String?    @map("event_key") @db.VarChar(191)
  status        TodoStatus @default(OPEN)
  createdAt     DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  completedAt   DateTime?  @map("completed_at") @db.DateTime(3)
  staleAt       DateTime?  @map("stale_at") @db.DateTime(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  person        Person     @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([personId, status, module, createdAt])
  @@index([aggregateType, aggregateId, status])
  @@index([eventKey])
  @@map("todos")
}
