APP_ENV=local
APP_VERSION=
APP_BASE_URL=http://localhost:3000
ZLB_PROCESS=
NEXT_PUBLIC_APP_NAME=智链宝
PROD_HTTPS_ENABLED=false
ATTACHMENT_STORAGE_PROVIDER=
# Only local/unit/integration/E2E may opt into memory. Deployed environments stay blocked
# until a storage adapter included in the fixed CloudBase package is implemented and approved.
ENABLE_TEST_MEMORY_ATTACHMENT_STORAGE=false
ATTACHMENT_BUCKET=local-private-attachments
ATTACHMENT_REGION=local
FILE_SCAN_PROVIDER=
# APP_ENV never selects a scanner. TEST and PROD must explicitly configure clamav.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000
BACKUP_PROVIDER=unavailable
FILE_SCANNER_EVIDENCE_JSON=
CLOUD_BACKUP_EVIDENCE_JSON=
MAINTENANCE_EVIDENCE_JSON=
RESTORE_DRILL_EVIDENCE_JSON=
V1_REHEARSAL_EVIDENCE_JSON=
UAT_EVIDENCE_JSON=
PROD_PREFLIGHT_EVIDENCE_JSON=
REAL_AI_EVIDENCE_JSON=
BAOYING_COUNTY_GOV_LATITUDE=
BAOYING_COUNTY_GOV_LONGITUDE=
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/zhilianbao_v2
ADMIN_CONTACT_PHONE=0514-XXXXXXXX
AUTH_RATE_LIMIT_SECRET=replace-with-a-long-random-secret
ATTACHMENT_SIGNED_URL_TTL_SECONDS=300
ATTACHMENT_UPLOAD_TTL_SECONDS=900
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=2000
WORKER_JOB_LOCK_TIMEOUT_SECONDS=900
WORKER_HEARTBEAT_SECONDS=60
WORKER_GRACEFUL_SHUTDOWN_SECONDS=30
WORKER_RUN_ONCE=false
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10
DEMAND_CLAIM_PERIOD_DAYS=30
