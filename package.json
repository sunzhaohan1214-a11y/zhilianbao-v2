{
  "name": "zhilianbao-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "npm run build:web && npm run build:worker",
    "build:web": "next build",
    "build:worker": "esbuild src/worker/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=worker-dist/main.js --packages=external",
    "start": "next start",
    "start:web": "node server.js",
    "start:worker": "node worker-dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:worker": "vitest run tests/unit/worker-foundation.test.ts tests/integration/worker-runtime.test.ts",
    "test:database": "vitest run tests/database --maxWorkers=1",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "test:e2e:critical": "playwright test --project=chromium"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "cos-js-sdk-v5": "1.10.1",
    "cos-nodejs-sdk-v5": "3.0.0",
    "dotenv": "17.2.3",
    "exceljs": "4.4.0",
    "file-type": "22.0.2",
    "next": "16.3.3",
    "pdf-lib": "1.17.1",
    "qcloud-cos-sts": "3.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "esbuild": "0.28.2",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
